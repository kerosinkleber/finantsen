# --- Pflicht ---
# Domain, unter der die App erreichbar ist (DNS A/AAAA-Eintrag muss auf den Server zeigen).
# Caddy besorgt automatisch ein HTTPS-Zertifikat. Zum lokalen Testen: localhost
DOMAIN=localhost
# Passwort der Datenbank, z. B. erzeugen mit: openssl rand -hex 24
POSTGRES_PASSWORD=change-me

# --- Optional ---
# Öffentliche URL (für Einladungslinks / Secure-Cookies). Standard: https://$DOMAIN
# APP_URL=https://splits.example.com
# Reserviert für Signaturen späterer Funktionen: openssl rand -hex 32
APP_SECRET=
# Registrierung ohne Einladung erlauben? Der allererste Nutzer (wird Admin) kann sich immer
# registrieren; mit Einladungslink geht es auch bei "false".
REGISTRATION_ENABLED=true
# Sprache für neue Nutzer ohne Browsersprache: de oder en
DEFAULT_LOCALE=de

# --- Nur für Entwicklung ohne Docker ---
# DATABASE_URL=postgres://finantsen:finantsen@localhost:5432/finantsen

# --- Web Push (optional) ---
# Schlüssel erzeugen mit: npm run vapid   (ohne Schlüssel sind Push-Nachrichten deaktiviert,
# In-App-Benachrichtigungen funktionieren trotzdem)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# --- Wechselkurse ---
# Anbieter: fawazahmed0 (Standard, kostenlos, 200+ Währungen, historisch) | open-er-api | frankfurter | static
EXCHANGE_RATE_PROVIDER=fawazahmed0
# Nur für "static" (Offline-Betrieb): Kurse pro 1 EUR als JSON, z. B. {"USD":1.08,"JPY":162}
# EXCHANGE_RATES_STATIC=

# --- Belegscan (optional) ---
# Anthropic-API-Key aktiviert den Belegscan (Foto -> Positionen, immer vom Nutzer zu bestätigen).
# Ohne Key ist die Funktion ausgeblendet. Fotos werden an die Anthropic-API gesendet, nicht gespeichert.
ANTHROPIC_API_KEY=
# Modell für den Scan (Standard: claude-opus-5-5; ein günstigeres Modell ist möglich)
# RECEIPT_SCAN_MODEL=
