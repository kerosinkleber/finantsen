# --- Pflicht ---
# Öffentliche Domain für Caddy (automatisches HTTPS). Lokal: localhost
DOMAIN=localhost
# Öffentliche URL der App (wird u. a. für Einladungslinks verwendet)
APP_URL=https://localhost
# Postgres-Passwort (z. B. `openssl rand -hex 24`)
POSTGRES_PASSWORD=change-me
# Geheimer Schlüssel für zukünftige Signaturen (z. B. `openssl rand -hex 32`)
APP_SECRET=change-me

# --- Optional ---
# Registrierung ohne Einladung erlauben? Der erste Nutzer kann sich immer registrieren.
# Mit Einladungslink ist die Registrierung auch bei "false" möglich.
REGISTRATION_ENABLED=true
# Sprache für neue Nutzer: de oder en
DEFAULT_LOCALE=de

# --- Nur für Entwicklung ohne Docker ---
# DATABASE_URL=postgres://finantsen:finantsen@localhost:5432/finantsen
