# Konfiguration für docker-compose.nas.yml. Kopieren als ".env" in denselben Ordner und ausfüllen.
# Niemals mit echten Werten ins Git-Repo legen.

# Adresse, unter der du die App im Browser öffnest: IP-Adresse des NAS und Port (siehe APP_PORT)
APP_URL=http://192.168.178.20:3000
# Port auf dem NAS (frei wählen, falls 3000 schon belegt ist; dann auch in APP_URL anpassen)
APP_PORT=3000

# Datenbankpasswort: lange Zufallsfolge aus Buchstaben und Ziffern (z. B. aus dem Passwortmanager, 32 Zeichen)
POSTGRES_PASSWORD=
# Geheimer Schlüssel der App: lange Zufallsfolge (mind. 16, besser 64 Zeichen). Gut aufbewahren und NIE ändern,
# sonst funktionieren eingerichtete Zwei-Faktor-Anmeldungen nicht mehr.
APP_SECRET=

# Welche App-Version: "latest" = Stand von main. Vor dem Zusammenführen des Entwicklungszweigs:
# FINANTSEN_TAG=claude-magical-feynman-h8qjkz
FINANTSEN_TAG=latest

DEFAULT_LOCALE=de

# --- Optional ---
# Speicher-Obergrenze der App (Standard 256 MB, gemessen: gut 40 % weniger Spitzenverbrauch). Nur ändern, falls
# im Log "heap out of memory" steht, z. B. auf --max-old-space-size=512.
# NODE_OPTIONS=--max-old-space-size=256
# Mailversand, z. B. GMX: smtps://deine.adresse%40gmx.de:PASSWORT@mail.gmx.net:465  (@ im Namen als %40 schreiben)
SMTP_URL=
MAIL_FROM=
# Push-Nachrichten (braucht HTTPS, über http:// ohne Wirkung)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
